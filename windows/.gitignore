# Windows stack build output. Vendored deps (daemon/vendor/**) stay tracked.
**/target/
winui/**/bin/
winui/**/obj/
.vs/
*.user
DvlErrLog.txt

# Prebuilt/release output — produced by CI, never committed
dist/

# devcon.exe is bundled with the installer (needed to create the ROOT mic device)
!installer/tools/devcon.exe

# Driver build output (local WDK builds; CI builds its own)
drivers/**/x64/
drivers/mic-portcls/x64/
# The mic driver package is built by CI, never committed
drivers/mic-portcls/prebuilt/
